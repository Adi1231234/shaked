{
  "manifest_version": 3,
  "name": "Complete Anatomy - מבחן מוח",
  "description": "כלי תרגול עצמי: בוחר איבר אקראי מרשימת המבחן, מסמן אותו על המודל התלת-ממדי ומסתיר את שמו עד שלוחצים לחשיפה.",
  "version": "1.1.0",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://completeanatomy.app/*"],
      "js": [
        "src/store.js",
        "src/api.js",
        "src/quiz.js",
        "src/ui-modal.js",
        "src/ui-setup.js",
        "src/ui-quiz.js",
        "src/content.js"
      ],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/structures.json"],
      "matches": ["https://completeanatomy.app/*"]
    }
  ]
}

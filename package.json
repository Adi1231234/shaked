{
  "name": "shaked",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Everything built for Shaked's medical degree - one monorepo, one hub site.",
  "workspaces": [
    "tools/vite-preset",
    "apps/cv",
    "apps/ent-roadmap",
    "apps/hub",
    "apps/song"
  ],
  "scripts": {
    "build": "node tools/build/site.mjs",
    "preview": "node tools/build/serve.mjs",
    "dev:cv": "npm run dev -w @shaked/cv",
    "dev:ent-roadmap": "npm run dev -w @shaked/ent-roadmap",
    "dev:hub": "npm run dev -w @shaked/hub",
    "dev:song": "npm run dev -w @shaked/song",
    "check": "node tools/check/run.mjs"
  },
  "dependencies": {
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "autoprefixer": "10.4.20",
    "lucide-react": "0.460.0",
    "playwright": "^1.62.1",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.9.3",
    "vite": "8.0.10"
  },
  "engines": {
    "node": ">=20"
  }
}

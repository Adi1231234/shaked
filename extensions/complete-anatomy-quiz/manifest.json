{
  "manifest_version": 3,
  "name": "Complete Anatomy - מבחן מוח",
  "description": "כלי תרגול עצמי: בוחר איבר אקראי מרשימת המבחן, מסמן אותו על המודל התלת-ממדי ומסתיר את שמו עד שלוחצים לחשיפה.",
  "version": "2.1.0",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://completeanatomy.app/*"],
      "js": [
        "src/store.js",
        "src/liststore.js",
        "src/api.js",
        "src/quiz.js",
        "src/ui-list.js",
        "src/ui-filter.js",
        "src/ui-areabar.js",
        "src/ui-excluded.js",
        "src/ui-import.js",
        "src/match.js",
        "src/ui-modal.js",
        "src/ui-setup.js",
        "src/ui-quiz.js",
        "src/add-menu.js",
        "src/search-add.js",
        "src/content.js"
      ],
      "css": ["src/styles.css", "src/styles-add.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/structures.json", "src/structures-headneck.json"],
      "matches": ["https://completeanatomy.app/*"]
    }
  ]
}
